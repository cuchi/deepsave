# Database
DATABASE_URL=postgres://deepsave:deepsave@localhost:5432/deepsave
PORT=8080

# DeepSeek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# Token prices (USD per 1M tokens)
DEEPSEEK_INPUT_PRICE_PER_M=0.27
DEEPSEEK_CACHE_HIT_PRICE_PER_M=0.07
DEEPSEEK_OUTPUT_PRICE_PER_M=1.10

# Storage & session
STORAGE_DIR=./storage
COVERAGE_MONTHS=12          # how many months of source coverage to track
SESSION_SECRET=deepsave-dev-secret-change-me-0123456789
COOKIE_SECURE=false          # set true once the site is served over HTTPS
APP_PASSWORD_HASH=          # argon2 hash (preferred in production)
APP_PASSWORD=deepsave       # plaintext, hashed at startup (dev convenience)

# Pluggy (open-banking aggregation) — optional; without it the /pluggy UI is disabled.
# Accounts are config-driven: ids come from the Pluggy dashboard (stable) and are
# listed here as a JSON array (bank: nubank|caixa|c6, kind: BANK|CREDIT).
# Auth: client id/secret auto-refresh the API token; PLUGGY_API_KEY is an alternative
# (2h JWT — when it expires, regenerate it, e.g. via POST /auth).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_API_KEY=
PLUGGY_ACCOUNTS="[{\"id\":\"00000000-0000-0000-0000-00000000c101\",\"bank\":\"nubank\",\"kind\":\"BANK\",\"name\":\"Nubank - Conta\"},{\"id\":\"00000000-0000-0000-0000-00000000c102\",\"bank\":\"nubank\",\"kind\":\"CREDIT\",\"name\":\"Nubank - Cartão\"},{\"id\":\"00000000-0000-0000-0000-00000000c103\",\"bank\":\"caixa\",\"kind\":\"BANK\",\"name\":\"Caixa - Conta\"},{\"id\":\"00000000-0000-0000-0000-00000000c104\",\"bank\":\"caixa\",\"kind\":\"CREDIT\",\"name\":\"Caixa - Cartão\"},{\"id\":\"00000000-0000-0000-0000-00000000c105\",\"bank\":\"c6\",\"kind\":\"BANK\",\"name\":\"C6 - Conta\"},{\"id\":\"00000000-0000-0000-0000-00000000c106\",\"bank\":\"c6\",\"kind\":\"CREDIT\",\"name\":\"C6 - Cartão\"}]"
